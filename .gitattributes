# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf

# Go sources must stay LF: gofmt treats CRLF files as unformatted, so a CRLF
# checkout would make `gofmt -l` (and `make check`) fail on every file.
*.go text eol=lf

# Makefiles must stay LF too: CRLF breaks `\` line continuations in POSIX shells.
Makefile text eol=lf

# Frontend sources must stay LF: Prettier's default `endOfLine` is `lf`, so a
# CRLF checkout would make `prettier --check` (and the frontend `lint` job) fail
# on every file. `text=auto` keeps git's binary detection for assets.
frontend/** text=auto eol=lf
