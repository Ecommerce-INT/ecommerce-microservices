# Server-side origin of the API gateway (APISIX). The browser never calls it —
# every API request goes through remote functions on the SvelteKit server.
API_INTERNAL_URL=http://localhost:9080

# Browser-reachable gateway origin. Only needed when it differs from the
# internal URL (the SSO login redirect hands the browser to the gateway).
# Defaults to API_INTERNAL_URL.
# API_PUBLIC_URL=http://localhost:9080

# Built server (`bun ./build`) — defaults to port 3000, the backoffice uses 3001.
# PORT=3001
# HOST=0.0.0.0

# Set when serving plain HTTP (compose) or behind a proxy (cluster).
# ORIGIN=http://localhost:3001
# PROTOCOL_HEADER=x-forwarded-proto
